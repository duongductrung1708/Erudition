<node id="Self-Learning">
  <data key="d0">Self-Learning</data>
  <data key="d1">category</data>
  <data key="d2">Self-Learning là khả năng tự tìm kiếm và học tập kiến thức mới mà không cần sự hướng dẫn trực tiếp.</data>
  <data key="d3">chunk-7ba071e96df534d3e89d1e6a171012f6</data>
  <data key="d4">6a2ca7b4-b00f-4da4-b7f5-d8d904a3db1b</data>
