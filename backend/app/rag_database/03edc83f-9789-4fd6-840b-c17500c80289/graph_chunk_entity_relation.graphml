<node id="Developer">
  <data key="d0">Developer</data>
  <data key="d1">person</data>
  <data key="d2">Developer là những cá nhân có chuyên môn trong việc lập trình và phát triển ứng dụng, đặc biệt là trong lĩnh vực front-end.</data>
  <data key="d3">chunk-605b6859de26771b3e0b6218329c8700</data>
  <data key="d4">6a2ca7b4-b00f-4da4-b7f5-d8d904a3db1b</data>
</node>
<node id="Application">
  <data key="d0">Application</data>
  <data key="d1">category</data>
  <data key="d2">Application là phần mềm được thiết kế để thực hiện các tác vụ cụ thể, thường chạy trên thiết bị di động hoặc máy tính.</data>
  <data key="d3">chunk-605b6859de26771b3e0b6218329c8700</data>
  <data key="d4">6a2ca7b4-b00f-4da4-b7f5-d8d904a3db1b</data>
