<node id="Email">
  <data key="d0">Email</data>
  <data key="d1">category</data>
  <data key="d2">Email là một dạng giao tiếp trực tuyến phổ biến, dùng để gửi và nhận thông tin giữa các cá nhân.</data>
  <data key="d3">chunk-566f60a230a0eedd8d7f8a548e0da62d</data>
