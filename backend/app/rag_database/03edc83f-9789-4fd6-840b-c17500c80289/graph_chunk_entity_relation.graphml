<node id="Critical Thinking">
  <data key="d0">Critical Thinking</data>
  <data key="d1">category</data>
  <data key="d2">Critical Thinking là khả năng phân tích và đánh giá thông tin một cách logic và khách quan trước khi đưa ra quyết định.</data>
  <data key="d3">chunk-7ba071e96df534d3e89d1e6a171012f6</data>
