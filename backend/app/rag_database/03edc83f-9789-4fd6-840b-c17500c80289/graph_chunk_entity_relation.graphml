<node id="Bac Ninh">
  <data key="d0">Bac Ninh</data>
  <data key="d1">geo</data>
  <data key="d2">Bắc Ninh là một tỉnh ở miền Bắc Việt Nam, nổi tiếng với nhiều di tích lịch sử và văn hóa.</data>
  <data key="d3">chunk-958b222855c03630a1fd27e95c26fbd7</data>
  <data key="d4">6a2ca7b4-b00f-4da4-b7f5-d8d904a3db1b</data>
</node>
<node id="Email Address">
  <data key="d0">Email Address</data>
  <data key="d1">category</data>
  <data key="d2">Email Address là một phương thức giao tiếp điện tử quan trọng thường được sử dụng trong công việc và học tập.</data>
  <data key="d3">chunk-958b222855c03630a1fd27e95c26fbd7</data>
  <data key="d4">6a2ca7b4-b00f-4da4-b7f5-d8d904a3db1b</data>
